# shopRex - root security hardening.
# Complements the csrf_token check in includes/functions.php (requireCsrf())
# and the SameSite/HttpOnly session cookie set in config/config.php.

# ---------------------------------------------------------------
# Force HTTPS (optional, server-level)
# config/config.php already redirects HTTP -> HTTPS in PHP whenever your
# configured Site URL (Admin -> Settings) uses https:// - that's enough for
# most setups and won't break a http://-only local/staging environment.
# Uncomment below only if you want the same redirect done by Apache before
# PHP even runs (e.g. for performance) - do NOT enable this on a site still
# served over plain HTTP, or every request will redirect-loop.
# ---------------------------------------------------------------
# <IfModule mod_rewrite.c>
#     RewriteEngine On
#     RewriteCond %{HTTPS} off
#     RewriteCond %{HTTP:X-Forwarded-Proto} !https
#     RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# </IfModule>

# ---------------------------------------------------------------
# Security headers
# ---------------------------------------------------------------
<IfModule mod_headers.c>
    # Stops the site being framed by another origin - a common precursor to
    # "clickjacking" CSRF-style attacks that trick a logged-in user into
    # submitting a form they can't see.
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

    # Defense-in-depth against the app's two intentionally-trusted-HTML
    # surfaces (CMS page content in page.php, and admin-edited email
    # templates - see README.md's "Notes / known simplifications"): doesn't
    # change that trust model, but limits what injected markup could do if
    # a Manager/Super Admin account is ever compromised. 'unsafe-inline' is
    # required for script-src/style-src because the storefront and admin
    # both use inline <script>/style blocks throughout rather than a build
    # step - this still blocks arbitrary third-party script/style/frame/
    # object sources, which is the more likely exfiltration path. Update
    # the two CDN hosts below if you self-host the External libraries
    # listed in README.md instead.
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://code.jquery.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; img-src 'self' data:; font-src 'self' data: https://cdn.jsdelivr.net; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
</IfModule>

# ---------------------------------------------------------------
# Don't reveal directory contents anywhere in the project
# ---------------------------------------------------------------
Options -Indexes

# ---------------------------------------------------------------
# Block direct access to dotfiles (.env, .git, .htaccess itself, etc.)
# ---------------------------------------------------------------
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# ---------------------------------------------------------------
# Front-controller routing (v2.00 OOP rewrite - see src/routes/web.php
# and src/routes/admin.php). A real file or directory (uploads/, assets/,
# themes/, any legacy .php shim that still physically exists) is always
# served as-is first - only a request that doesn't correspond to a real
# path falls through to a front controller, which dispatches it via
# Core\Router. Everything under /admin goes to admin/index.php; every
# other path goes to the storefront's index.php.
# ---------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]
    RewriteRule ^admin(/.*)?$ admin/index.php [L,QSA]
    RewriteRule ^ index.php [L,QSA]
</IfModule>
